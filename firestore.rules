rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    // Boards collection rules
    match /boards/{boardId} {
      function isDemoBoard() {
        return resource != null && resource.data.userId == null;
      }
      
      // Read rules
      allow read: if 
        isDemoBoard() || // Allow reading demo/public boards
        isOwner(resource.data.userId);      // Allow reading own boards
      
      // Write rules
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'content', 'userId', 'savedAt']);
      
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Whiteboards collection rules
    match /whiteboards/{whiteboardId} {
      // Read rules
      allow get, list: if isSignedIn();
      
      // Write rules
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'items', 'connections', 'userId', 'createdAt', 'updatedAt']);
      
      allow update, delete: if isSignedIn() 
        && resource.data.userId == request.auth.uid;
    }
    
    // Community posts rules
    match /communityPosts/{postId} {
      allow read: if true;  // Anyone can read public posts
      allow create: if request.auth != null && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.createdAt == request.time;
      allow update, delete: if request.auth != null && 
                             resource.data.userId == request.auth.uid;
    }
    
    // User settings rules
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}