rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Boards collection rules
    match /boards/{boardId} {
      function isDemoBoard() {
        return resource != null && resource.data.userId == null;
      }
      
      // Read rules
      allow read: if 
        isDemoBoard() || // Allow reading demo/public boards
        isOwner(resource.data.userId);      // Allow reading own boards
      
      // Write rules
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'content', 'userId', 'savedAt']);
      
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    // User settings rules
    match /userSettings/{userId} {
      // Temporarily more permissive rules for debugging
      allow read: if request.auth != null && request.auth.uid == userId;
      
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}