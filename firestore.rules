rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Shared helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailLookupQuery() {
      return request.query != null
        && request.query.filters.size() == 1
        && request.query.filters[0].field == 'email'
        && request.query.filters[0].op == '=='
        && request.query.filters[0].value is string;
    }

    function boardDoc(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId));
    }

    function boardExists(boardId) {
      return exists(/databases/$(database)/documents/boards/$(boardId));
    }

    function canAccessBoard(boardId) {
      return boardExists(boardId) && (
        boardDoc(boardId).data.userId == null ||
        boardDoc(boardId).data.userId == request.auth.uid ||
        (
          boardDoc(boardId).data.sharedWith != null
          && request.auth.uid in boardDoc(boardId).data.sharedWith
        )
      );
    }

    function ownsBoard(boardId) {
      return boardExists(boardId)
        && boardDoc(boardId).data.userId == request.auth.uid;
    }

    function isNotificationRecipient() {
      return resource.data.userId == request.auth.uid
        || (
          resource.data.pending == true
          && resource.data.userEmail is string
          && request.auth.token.email is string
          && resource.data.userEmail.lower() == request.auth.token.email.lower()
        );
    }

    // -------------------------------------------------------------------------
    // Users
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) || isSignedIn();

      allow list: if isSignedIn() && isEmailLookupQuery();

      allow create: if isOwner(userId)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.tier == 'FREE'
        && !request.resource.data.keys().hasAny(['stripeCustomerId', 'stripeSubscriptionId', 'updatedAt']);

      allow update: if isOwner(userId)
        && request.resource.data.tier == resource.data.get('tier', 'FREE')
        && request.resource.data.get('stripeCustomerId', null) == resource.data.get('stripeCustomerId', null)
        && request.resource.data.get('stripeSubscriptionId', null) == resource.data.get('stripeSubscriptionId', null)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stripeCustomerId', 'stripeSubscriptionId']);
    }

    // -------------------------------------------------------------------------
    // Boards
    // -------------------------------------------------------------------------
    match /boards/{boardId} {
      function isDemoBoard() {
        return resource != null && resource.data.userId == null;
      }

      function isBoardOwner() {
        return isSignedIn()
          && resource != null
          && resource.data.userId != null
          && resource.data.userId == request.auth.uid;
      }

      function isSharedWith() {
        return isSignedIn()
          && resource != null
          && resource.data.sharedWith != null
          && request.auth.uid in resource.data.sharedWith;
      }

      function hasEditorPermission() {
        return isSharedWith();
      }

      allow read: if
        isDemoBoard()
        || isBoardOwner()
        || isSharedWith();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.keys().hasAll(['name', 'content', 'userId', 'savedAt']);

      allow update: if request.resource.data.userId == resource.data.userId && (
        isBoardOwner()
        || (
          isSharedWith()
          && hasEditorPermission()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'content', 'folderId', 'savedAt', 'lastEditedAt', 'chatHistory'
          ])
        )
      );

      allow delete: if isBoardOwner();
    }

    // -------------------------------------------------------------------------
    // Board shares
    // -------------------------------------------------------------------------
    match /boardShares/{shareId} {
      allow read: if isSignedIn() && (
        resource.data.sharedWithUserId == request.auth.uid
        || resource.data.boardOwnerId == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.boardOwnerId == request.auth.uid
        && request.resource.data.boardId is string
        && request.resource.data.sharedWithEmail is string
        && request.resource.data.sharedWithEmail.size() <= 320
        && request.resource.data.permission in ['viewer', 'editor']
        && request.resource.data.status in ['pending', 'accepted']
        && ownsBoard(request.resource.data.boardId);

      allow update, delete: if isSignedIn() && (
        resource.data.boardOwnerId == request.auth.uid
        || resource.data.sharedWithUserId == request.auth.uid
      );
    }

    // -------------------------------------------------------------------------
    // Notifications
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isNotificationRecipient();

      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.type == 'board_shared'
        && request.resource.data.boardId is string
        && request.resource.data.read == false
        && ownsBoard(request.resource.data.boardId)
        && (
          (
            request.resource.data.userId is string
            && request.resource.data.userId != request.auth.uid
            && !request.resource.data.keys().hasAny(['userEmail', 'pending'])
          )
          || (
            request.resource.data.userEmail is string
            && request.resource.data.userEmail.size() <= 320
            && request.resource.data.pending == true
            && !request.resource.data.keys().hasAny(['userId'])
          )
        );

      allow update: if isSignedIn() && isNotificationRecipient() && (
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        )
        || (
          resource.data.pending == true
          && resource.data.userEmail is string
          && request.auth.token.email is string
          && resource.data.userEmail.lower() == request.auth.token.email.lower()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.pending == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'pending', 'userEmail'])
        )
      );

      allow delete: if isSignedIn() && isNotificationRecipient();
    }

    // -------------------------------------------------------------------------
    // Board presence
    // -------------------------------------------------------------------------
    match /boardPresence/{presenceId} {
      allow read: if isSignedIn()
        && resource.data.boardId is string
        && canAccessBoard(resource.data.boardId);

      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.boardId is string
        && canAccessBoard(request.resource.data.boardId);

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Whiteboards (legacy collection — owner-only)
    // -------------------------------------------------------------------------
    match /whiteboards/{whiteboardId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.keys().hasAll(['name', 'items', 'connections', 'userId', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Community posts
    // -------------------------------------------------------------------------
    match /communityPosts/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && (
          request.resource.data.createdAt == request.time
          || (
            request.resource.data.createdAt is string
            && request.resource.data.createdAt.size() <= 40
          )
        );

      allow update: if isSignedIn() && (
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
        )
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // User settings
    // -------------------------------------------------------------------------
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Encryption keys — server-only via Admin SDK
    match /userKeys/{userId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // User usage tracking
    // -------------------------------------------------------------------------
    match /userUsage/{userId} {
      allow read, create, update: if isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // Folders
    // -------------------------------------------------------------------------
    match /folders/{folderId} {
      function isFolderOwner() {
        return isSignedIn()
          && resource != null
          && resource.data.userId == request.auth.uid;
      }

      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200;

      allow update: if isSignedIn()
        && isFolderOwner()
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn() && isFolderOwner();
    }

    // -------------------------------------------------------------------------
    // Default deny
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
