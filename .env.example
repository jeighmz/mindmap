# --- Firebase (client — baked into the React build) ---
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
REACT_APP_FIREBASE_PROJECT_ID=your_project_id_here
REACT_APP_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
REACT_APP_FIREBASE_APP_ID=your_app_id_here
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# --- Stripe (client publishable key + product IDs) ---
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
REACT_APP_STRIPE_PRODUCT_ID_STARTER=prod_xxx
REACT_APP_STRIPE_PRODUCT_ID_PRO=prod_xxx
REACT_APP_STRIPE_PRODUCT_ID_CREATOR_AI=prod_xxx

# --- Netlify Functions (server-side only — set in Netlify dashboard, NOT prefixed with REACT_APP_) ---
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_PORTAL_RETURN_URL=https://your-site.netlify.app/settings
STRIPE_TRIAL_PERIOD_DAYS=14
SITE_URL=https://your-site.netlify.app
GROQ_API_KEY=your_groq_api_key_here
# Use production model - llama-3.3-70b-versatile was deprecated Aug 16, 2026
GROQ_MODEL=openai/gpt-oss-120b
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
